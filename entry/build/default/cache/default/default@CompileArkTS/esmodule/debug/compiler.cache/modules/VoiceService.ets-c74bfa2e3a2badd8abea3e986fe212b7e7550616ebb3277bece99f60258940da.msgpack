                requestId: `cue-${VoiceService.requestSequence}`,
                extraParams: {
                    queueMode: 1,
                    speed: 1,
                    volume: 1,
                    pitch: 1,
                    languageContext: language,
                    audioType: 'pcm',
                    soundChannel: 3,
                    playType: 1
                }
