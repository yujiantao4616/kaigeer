                        Text.fontSize(48);
                        Text.fontWeight(FontWeight.Bold);
                        Text.fontColor(this.textColor);
                        Text.scale({ x: this.countdownScale, y: this.countdownScale });
                    }, Text);
                    Text.pop();
                    this.observeComponentCreation2((elmtId, isInitialRender) => {
