                        ? 'æš‚åœ'
                        : state.phase === 'ready'
                            ? `å‡†å¤‡ Â· ${compactSetText}`
                            : `${phaseShort} Â· ${currentRepetition}/${totalRepetitions}æ¬¡`,
                    time: timerSeconds * 1000,
                    isCountdown: true,
                    isPaused: state.paused,
                    isContentDisplayed: true,
                    backgroundColor: '#FF087F73'
                }
            }
        };
    }
}
