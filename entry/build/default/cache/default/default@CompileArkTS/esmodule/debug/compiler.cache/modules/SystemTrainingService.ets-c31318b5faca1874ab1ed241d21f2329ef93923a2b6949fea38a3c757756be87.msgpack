        return {
            id: LIVE_VIEW_ID,
            // WORKOUT maps this card to HarmonyOS' exercise/training scene. The
            // app still uses the timer payload so the capsule itself counts down
            // once per second without requiring an update call for every tick.
            event: 'WORKOUT',
