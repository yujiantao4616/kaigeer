    if (phase === 'complete') {
      return 'å·²å®Œæˆ';
    }
    return 'å‡†å¤‡';
  }

  /**
   * The capsule has very little horizontal space. Keep its phase label short
   * and leave the detailed coaching copy to the expanded card/lock screen.
   */
  private static phaseShortLabel(phase: TrainingPhase): string {
    if (phase === 'tighten') {
      return 'æ”¶ç´§';
